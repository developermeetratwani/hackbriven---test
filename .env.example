# Story engine (Stage 2: Intelligence)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Image generation (Stage 4: Generation)
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
# Pollinations fallback needs no key

# Voice (Stage 5) — edge-tts needs no key
EDGE_TTS_VOICE=en-US-AriaNeural

# Captions (Stage 6)
WHISPER_MODEL=base

# Optional motion (Stage 7)
FAL_API_KEY=
FAL_MOTION_MODEL=fal-ai/ltx-video

# Storage & output
STORAGE_DIR=storage/jobs
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MAX_REGENERATE_ATTEMPTS=2

# Provider HTTP timeouts (seconds)
PROVIDER_TIMEOUT_SECONDS=30
